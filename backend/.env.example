# Travelgram backend configuration. Copy to .env and fill in.
PORT=4000

# Ammachi's brain: Google Gemini (https://aistudio.google.com/apikey)
# Without a key Ammachi still answers from the journey catalogue, labelled "offline".
GEMINI_API_KEY=
# Google's alias for the current stable Flash model. Pin e.g. gemini-3.8-flash if you prefer.
GEMINI_MODEL=gemini-flash-latest
# MINIMAL | LOW | MEDIUM | HIGH. LOW keeps voice replies snappy. Leave empty to use the model default.
GEMINI_THINKING_LEVEL=LOW

# Ammachi's voice: Sarvam AI Bulbul text-to-speech (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=priya
SARVAM_PACE=1.0

# Admin dashboard key (leave empty to generate one into data/dashboard-key.txt)
DASHBOARD_KEY=

# Outbound AI calls: Plivo dials, the Pipecat agent in voice-agent/ talks. Leave empty to simulate calls.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Public https URL Plivo can reach (your domain or tunnel)
PUBLIC_URL=
VOICE_AGENT_URL=http://127.0.0.1:8765
AUTO_CALL_SCORE=70
# Demo only: accept documents marked SPECIMEN (scripts/make-specimens.py)
DOC_CHECK_ALLOW_SPECIMENS=false
